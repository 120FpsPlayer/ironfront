# ─────────────────────────────────────────────────────────────
#  Bot HammerShop – ustawienia
#  Skopiuj ten plik do „.env” i uzupełnij co najmniej DISCORD_TOKEN.
# ─────────────────────────────────────────────────────────────

# Token bota (Developer Portal → Twoja aplikacja → Bot → Reset Token). NIGDY nikomu go nie podawaj!
DISCORD_TOKEN=

# ID Twojego serwera – komendy pojawiają się na nim od razu. Zostaw puste dla komend globalnych (mogą pojawić się po kilku minutach).
GUILD_ID=

# Dodatkowi właściciele bota (ID użytkowników, oddzielone przecinkami). Właściciel serwera zawsze jest właścicielem bota.
OWNER_IDS=

# ── Opcjonalne ─────────────────────────────────────────────
# /zbuduj sam tworzy i ustawia swoje role. Użyj tych pól tylko dla dodatkowych ról utworzonych ręcznie.
ADMIN_ROLE_IDS=
SUPPORT_ROLE_IDS=
# Zespół tylko dla jednej kategorii ticketów, np. SUPPORT_ROLE_IDS_ORDER=... (ORDER, SUPPORT, REWARD, PARTNERSHIP, REPORT, APPLY, APPEAL)
SUPPORT_ROLE_IDS_ORDER=
# Kto może otwierać tickety (puste = wszyscy) / kto nie może
OPEN_ROLE_IDS=
BLOCKED_ROLE_IDS=

# true = osoby z uprawnieniem Discorda „Administrator”/„Zarządzaj serwerem” są adminami bota
DISCORD_ADMINS_ARE_ADMINS=true
# false = tylko admini mogą usuwać tickety
STAFF_CAN_DELETE=true
# Czy autor ticketu może sam go zamknąć?
OWNER_CAN_CLOSE=true
# Rejestruj komendy przy każdym uruchomieniu
AUTO_DEPLOY_COMMANDS=true

# ── Stripe (opcjonalnie) ───────────────────────────────────
# Z kluczem zamówienia opłacane przez „Stripe” dostają w tickecie link do płatności kartą, a bot sam zmienia ich status
# na Opłacone, gdy zostaną opłacone. Stripe Dashboard → Developers → API keys → Secret key (sk_live_… – albo sk_test_…,
# żeby najpierw wypróbować). Wystarczy klucz ograniczony (rk_…) z uprawnieniem „Checkout Sessions: Write”. NIGDY nikomu go nie podawaj!
STRIPE_SECRET_KEY=

# ── PayPal (opcjonalnie) ───────────────────────────────────
# Z tymi kluczami zamówienia opłacane przez „PayPal” dostają w tickecie link do płatności PayPal, a bot sam pobiera
# pieniądze i zmienia status na Opłacone. developer.paypal.com → Apps & Credentials → Live (albo Sandbox, żeby
# wypróbować) → Twoja aplikacja → Client ID i Secret. NIGDY nikomu nie podawaj Secret! Bez nich karta PayPal pokazuje
# Twój link paypal.me (config.json → metoda płatności PayPal → "paypalMe": "twojanazwa").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = PayPal Sandbox (konta testowe, bez prawdziwych pieniędzy)
PAYPAL_SANDBOX=false

# ── Strona sklepu (opcjonalnie) ────────────────────────────
# Bot prowadzi też stronę Twojego sklepu HammerShop – ten sam program, ten sam serwer. Strona sprzedaje to, co jest
# w sklepie bota (/produkt …): logowanie przez Discorda (do zakupu wystarczy się zalogować – osoby, których jeszcze nie ma
# na serwerze, są dodawane z rolą Członek), koszyk i płatności kartą (Stripe, klucz powyżej), a każde opłacone zamówienie
# otwiera swój ticket tutaj, na Discordzie, i jest dostarczane jak każde inne zamówienie.
# Port: WEB_PORT – albo zostaw puste na panelu hostingowym, bot użyje portu, który ten przydzieli (SERVER_PORT / PORT).
WEB_PORT=
# Adres, który otwierają ludzie (bez ukośnika na końcu), np. https://hammershop.pl albo http://123.45.67.89:25565
PUBLIC_URL=
# Logowanie przez Discorda: Developer Portal → aplikacja Twojego bota → OAuth2 → Client Secret (Reset Secret), a w sekcji
# Redirects dodaj  <PUBLIC_URL>/api/shop/auth/callback  (np. https://hammershop.pl/api/shop/auth/callback)
DISCORD_CLIENT_SECRET=
# Zalecane: Stripe → Developers → Webhooks → dodaj endpoint <PUBLIC_URL>/api/shop/stripe/webhook ze zdarzeniami
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired – potem wklej tutaj jego sekret podpisu (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Opcjonalnie: zaproszenie dla przycisków Pomoc na stronie (puste = bot sam utworzy stałe zaproszenie)
# i serwer, którego sklep sprzedaje strona (puste = GUILD_ID albo jedyny serwer, na którym jest bot)
DISCORD_INVITE_URL=
WEB_GUILD_ID=
# WEB_ENABLED=false wyłącza stronę
