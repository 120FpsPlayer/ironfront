# ───────── NØX website ─────────
# Copy this file to .env and fill it in. Everything is optional: without Discord + Stripe the site shows its
# offline preview (demo account, no payments).

# The port the server listens on, and the address people open (no slash at the end).
PORT=3000
PUBLIC_URL=https://your-domain.com

# Discord sign-in – https://discord.com/developers/applications → your app → OAuth2
#   Redirects: add  https://your-domain.com/api/nox/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your server invite (Support / "Meet the community" buttons) – use one that never expires
DISCORD_INVITE_URL=https://discord.gg/your-invite
# Optional: a channel webhook – every paid order is posted there (Channel settings → Integrations → Webhooks)
DISCORD_ORDER_WEBHOOK_URL=

# Stripe – https://dashboard.stripe.com/apikeys  (sk_test_… to test, sk_live_… for real money)
STRIPE_SECRET_KEY=
# Optional but recommended: Developers → Webhooks → add endpoint https://your-domain.com/api/nox/stripe/webhook
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur

# The one-time NØX Access price in euros (0 = free – signing in with Discord is enough)
ACCESS_PRICE=9.90
