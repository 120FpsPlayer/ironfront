{
  "name": "hammer-launcher",
  "productName": "Hammer Launcher",
  "version": "2.6.0",
  "description": "Launcher Minecrafta od HammerShop – instancje, mody z Modrinth, optymalizacja i logowanie Microsoft.",
  "main": "src/main/main.js",
  "author": "HammerShop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "preview": "node scripts/preview.js",
    "preview:en": "node scripts/preview.js preview-en 1 --lang=en",
    "live-check": "node scripts/live-check.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "msmc": "5.0.5",
    "undici": "7.2.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "pl.hammershop.launcher",
    "productName": "Hammer Launcher",
    "copyright": "HammerShop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "launcher.config.json",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Hammer Launcher",
        "schemes": [
          "hammer"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Hammer-Launcher-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Hammer-Launcher-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hammer Launcher",
      "language": "1045",
      "installerLanguages": [
        "pl_PL"
      ],
      "artifactName": "Hammer-Launcher-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "extraResources": [
      {
        "from": "resources/hammer-client",
        "to": "hammer-client",
        "filter": [
          "versions.json",
          "*.jar"
        ]
      }
    ]
  }
}
