# ─────────────────────────────────────────────────────────────
#  NØX bot – settings
#  Copy this file to ".env" and fill in at least DISCORD_TOKEN.
# ─────────────────────────────────────────────────────────────

# Bot token (Developer Portal → your app → Bot → Reset Token). NEVER share it!
DISCORD_TOKEN=

# Your server ID – slash commands appear there instantly. Leave empty for global commands (can take a few minutes).
GUILD_ID=

# Extra bot owners (user IDs, comma separated). The server owner is always an owner.
OWNER_IDS=

# ── Optional ───────────────────────────────────────────────
# /build creates and uses its own roles automatically. Use these only for extra roles you made yourself.
ADMIN_ROLE_IDS=
SUPPORT_ROLE_IDS=
# Staff for one ticket category only, e.g. SUPPORT_ROLE_IDS_ORDER=... (ORDER, SUPPORT, REWARD, PARTNERSHIP, REPORT, APPLY, APPEAL)
SUPPORT_ROLE_IDS_ORDER=
# Who may open tickets (empty = everyone) / who may not
OPEN_ROLE_IDS=
BLOCKED_ROLE_IDS=

# true = people with Discord "Administrator"/"Manage Server" are bot admins
DISCORD_ADMINS_ARE_ADMINS=true
# false = only admins can delete tickets
STAFF_CAN_DELETE=true
# Can the ticket author close their own ticket?
OWNER_CAN_CLOSE=true
# Register slash commands on every start
AUTO_DEPLOY_COMMANDS=true

# ── Stripe (optional) ──────────────────────────────────────
# With a key, orders paid with "Stripe" get a card payment link in their ticket, and the bot sets them to Paid by
# itself once they're paid. Stripe Dashboard → Developers → API keys → Secret key (sk_live_… – or sk_test_… to try it).
# A restricted key (rk_…) with "Checkout Sessions: Write" is enough. NEVER share it!
STRIPE_SECRET_KEY=

# ── PayPal (optional) ──────────────────────────────────────
# With these, orders paid with "PayPal" get a PayPal payment link in their ticket, and the bot takes the money and
# sets them to Paid by itself. developer.paypal.com → Apps & Credentials → Live (or Sandbox to try it) → your app →
# Client ID and Secret. NEVER share the secret! Without them the PayPal card shows your paypal.me link
# (config.json → the PayPal payment method → "paypalMe": "yourname").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = PayPal sandbox (test accounts, no real money)
PAYPAL_SANDBOX=false

# ── Website (optional) ─────────────────────────────────────
# The bot runs your NØX store website too – same program, same server. It sells the bot's shop (/product …):
# Discord sign-in (that's all it takes to buy – people not on the server yet are added with the Member role), cart and
# card payments (Stripe, the key above), and every paid order opens its ticket here on Discord and is delivered like
# any other order.
# The port: WEB_PORT – or leave it empty on a hosting panel, the bot uses the port it gives (SERVER_PORT / PORT).
WEB_PORT=
# The address people open (no slash at the end), e.g. https://nox-shop.com or http://123.45.67.89:25565
PUBLIC_URL=
# Discord sign-in: Developer Portal → your bot's application → OAuth2 → Client Secret (Reset Secret), and under
# Redirects add  <PUBLIC_URL>/api/nox/auth/callback  (e.g. https://nox-shop.com/api/nox/auth/callback)
DISCORD_CLIENT_SECRET=
# Recommended: Stripe → Developers → Webhooks → add endpoint <PUBLIC_URL>/api/nox/stripe/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired – then paste its signing secret (whsec_…) here.
STRIPE_WEBHOOK_SECRET=
# Optional: an invite for the website's Support buttons (empty = the bot makes a permanent one itself),
# and which server's shop the website sells (empty = GUILD_ID or the one server the bot is in)
DISCORD_INVITE_URL=
WEB_GUILD_ID=
# WEB_ENABLED=false turns the website off
